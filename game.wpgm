import src.cultivos.*
import wollok.game.*
import personaje.*
import cultivos.*
import granja.*

program lagranja {
	//  CONFIG	
	game.title("La granja")
	game.height(10)
	game.width(10)
	game.ground("fondo.png")

 	game.addVisualCharacter(personaje)
 	
	keyboard.g().onPressDo({personaje.cambiarGenero()})
	keyboard.m().onPressDo({ personaje.plantar(new Maiz()) })
    keyboard.t().onPressDo({ personaje.plantar(new Trigo()) })
    keyboard.o().onPressDo({ personaje.plantar(new Tomaco()) })
	keyboard.r().onPressDo({personaje.regar()})
	keyboard.c().onPressDo({personaje.cosechar()})
	game.onCollideDo(mercado, {personaje => granja.venderTodo()})
	keyboard.space().onPressDo({personaje.informarVenta()})

 	//  COMIENZA
	game.start()
}
