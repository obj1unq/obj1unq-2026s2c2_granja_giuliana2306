import src.cultivos.*
import wollok.game.*
import granja.*
describe "test de la granja" {

    test "el personaje femenino cuando esta sobre nada" {
        personaje.genero(femenino)
        assert.equals("f-player-normal.png", personaje.image())
    }
    test "El personaje femenino cuando esta sobre algo" {
        personaje.genero(femenino)
        personaje.position(game.center())
        game.addVisual(objetoParaPrueba)
        assert.equals("f-player-abajo.png", personaje.image())
    }
    test "el personaje masculino cuando esta sobre nada" {
        personaje.genero(masculino)
        assert.equals("m-player-normal.png", personaje.image())
    }
    test "el personaje masculino cuando esta sobre algo" {
        personaje.genero(masculino)
        personaje.position(game.center())
        game.addVisual(objetoParaPrueba)
        assert.equals("m-player-abajo.png", personaje.image())
    }
    test "plantar tomaco" {
        var tomaco = new Tomaco()

        personaje.position(game.at(5,5))
        
        personaje.plantar(tomaco)
        assert.equals(game.at(5,5), tomaco.position())
        assert.equals(#{tomaco}, granja.cultivos())
    }
    test "Intentar plantar trigo" {
        var trigo = new Trigo()
        var tomaco = new Tomaco()

        personaje.position(game.at(5,5))
        personaje.plantar(tomaco)
        assert.throwsException({ personaje.plantar(trigo) })

        personaje.position(game.at(6,6))
        assert.throwsException({personaje.plantar(tomaco)})

        personaje.plantar(trigo)
        assert.equals(game.at(6,6), trigo.position())
        assert.equals(#{tomaco, trigo}, granja.cultivos())
    }
    test "sin cultivo" {
        assert.throwsException({personaje.regar()})
    }
    test "Plantar y regar maiz" {
        var maiz = new Maiz()

        personaje.plantar(maiz)
        assert.equals("maiz_bebe.png", maiz.image())
        personaje.regar()
        assert.equals("maiz_adulto.png", maiz.image())
        personaje.regar()
        assert.equals("maiz_adulto.png", maiz.image())
    }
    test "sembrar y regar trigo" {
         var trigo = new Trigo()

        personaje.plantar(trigo)
        assert.equals("trigo_0.png", trigo.image()) 
        personaje.regar()
        assert.equals("trigo_1.png", trigo.image())
        personaje.regar()
        assert.equals("trigo_2.png", trigo.image())
        personaje.regar()
        assert.equals("trigo_3.png", trigo.image())
        personaje.regar()
        assert.equals("trigo_0.png", trigo.image())
    }
    test "sembrar tomaco" {
        var tomaco = new Tomaco()
        var trigo = new Trigo()

        game.height(5)
        game.width(5)
        personaje.position(game.at(3,3))
        personaje.plantar(tomaco)
        personaje.regar()
        assert.equals(game.at(3,4), tomaco.position() )
        personaje.position(game.at(3,4))
        personaje.regar()
        assert.equals(game.at(3,0), tomaco.position())
        personaje.position(game.at(3,1))
        personaje.plantar(trigo)
        personaje.position(game.at(3,0))
        personaje.regar()
        assert.equals(game.at(3,0), tomaco.position())

    }
    test "Cosechar" {
        personaje.position(game.at(3,3))

        assert.throwsException({personaje.cosechar()})

        var tomaco = new Tomaco()
        personaje.plantar(tomaco) 
        personaje.cosechar()
        assert.equals(#{}, granja.cultivos())
        assert.equals([tomaco], granja.cultivosCosechados())

        var maiz = new Maiz()
        personaje.plantar(maiz)
        assert.throwsException({personaje.cosechar()})
        personaje.regar()
        personaje.cosechar()
        assert.equals(#{}, granja.cultivos()) 
        assert.equals([tomaco, maiz], granja.cultivosCosechados())

        var trigo = new Trigo()
        personaje.plantar(trigo)
        assert.throwsException({personaje.cosechar()})
        personaje.regar()
        assert.throwsException({personaje.cosechar()})
        personaje.regar()
        assert.that(trigo.sePuedeCosechar())
        personaje.regar()
        personaje.cosechar()
        assert.equals(#{}, granja.cultivos())
        assert.equals([tomaco, maiz, trigo], granja.cultivosCosechados())
    }
    test "Venta de cultivos" {

    personaje.position(game.at(3,3))

    var maiz = new Maiz()
    personaje.plantar(maiz)
    personaje.regar()
    personaje.cosechar()

    assert.equals(150, granja.oroPorVenta())

    var tomaco = new Tomaco()
    personaje.plantar(tomaco)
    personaje.cosechar()

    assert.equals(230, granja.oroPorVenta())

    var trigo = new Trigo()
    personaje.plantar(trigo)
    personaje.regar()
    personaje.regar()
    personaje.cosechar()

    assert.equals(330, granja.oroPorVenta())

    granja.venderTodo()

    assert.equals(330, granja.totalDeOro())
    assert.equals(0, granja.cantidadDeCosecha())
    assert.equals(0, granja.oroPorVenta())

    var otroTrigo = new Trigo()
    personaje.plantar(otroTrigo)
    personaje.regar()
    personaje.regar()
    personaje.regar()
    personaje.cosechar()

    assert.equals(200, granja.oroPorVenta())

    granja.venderTodo()

    assert.equals(530, granja.totalDeOro())
    assert.equals(0, granja.cantidadDeCosecha())
}
}

